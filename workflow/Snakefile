# BulkRNAPipe main Snakefile
include: 'rules/common.smk'
include: 'rules/qc.smk'
include: 'rules/trim.smk'
include: 'rules/align.smk'
include: 'rules/quantify.smk'
include: 'rules/deseq2.smk'
include: 'rules/pca.smk'
include: 'rules/design_qc.smk'
include: 'rules/signature_reversal.smk'
include: 'rules/gsea.smk'
include: 'rules/gsea_interaction.smk'
include: 'rules/go.smk'
include: 'rules/compare_contrasts.smk'
include: 'rules/report.smk'

# Define the pipeline working directory
workdir: config['User']['output_dir']

rule BulkRNAPipe_output:
    input:
        # ── Raw QC ────────────────────────────────────────────────────────────
        "QC/raw/multiqc/multiqc_report.html" if QC_RAW else [],
        # ── Trimming ──────────────────────────────────────────────────────────
        expand("trim/{sample}/{sample}_val_1.fq.gz", sample=SAMPLES) if TRIM and PAIRED else [],
        expand("trim/{sample}/{sample}_trimmed.fq.gz", sample=SAMPLES) if TRIM and not PAIRED else [],
        # ── Post-trim QC ──────────────────────────────────────────────────────
        "QC/trimmed/multiqc/multiqc_report.html" if QC_TRIMMED else [],
        # ── Alignment ─────────────────────────────────────────────────────────
        expand("align/{sample}/{sample}.Aligned.sortedByCoord.out.bam.bai", sample=SAMPLES) if ALIGN else [],
        "QC/align/multiqc/multiqc_report.html" if ALIGN else [],
        # ── Quantification ────────────────────────────────────────────────────
        "quantify/counts.txt" if QUANTIFY else [],
        # ── Differential expression ───────────────────────────────────────────
        expand("deseq2/{contrast}/results.csv", contrast=CONTRASTS) if DESEQ2 else [],
        expand("deseq2/{contrast}/volcano_proteomic.pdf", contrast=PROTEOMICS_CONTRASTS) if DESEQ2 and PROTEOMICS else [],
        # ── PCA (sample set x gene view grid) ─────────────────────────────────
        expand("pca/{sampleset}/{view}_pc12.pdf",
               sampleset=PCA_SAMPLE_SETS, view=PCA_VIEWS) if DESEQ2 else [],
        expand("pca/{sampleset}/{view}_pc34.pdf",
               sampleset=PCA_SAMPLE_SETS, view=PCA_VIEWS) if DESEQ2 else [],
        expand("pca/{sampleset}/{view}_scree.pdf",
               sampleset=PCA_SAMPLE_SETS, view=PCA_VIEWS) if DESEQ2 else [],
        expand("pca/{sampleset}/{view}_pc12_batch_removed.pdf",
               sampleset=PCA_SAMPLE_SETS, view=PCA_VIEWS) if DESEQ2 else [],
        # ── Design QC ─────────────────────────────────────────────────────────
        "design_qc/design_qc_summary.csv" if DESEQ2 else [],
        # Same rule as the summary above, listed explicitly so the panels are
        # requested by name rather than only as a side effect of that one file.
        "design_qc/marker_expression.pdf" if DESEQ2 else [],
        "design_qc/goi_expression.pdf" if DESEQ2 else [],
        # ── Interaction contrasts (difference of differences) ─────────────────
        expand("deseq2_interaction/{interaction}/results.csv",
               interaction=INTERACTIONS) if DESEQ2 else [],
        # ── Signature reversal ────────────────────────────────────────────────
        expand("signature_reversal/{comparison}/reversal_stats.csv",
               comparison=SIGNATURE_REVERSALS) if DESEQ2 else [],
        # ── GSEA ─────────────────────────────────────────────────────────────
        expand("gsea/{contrast}/{collection}_results.csv",
               contrast=CONTRASTS, collection=GSEA_COLLECTIONS) if GSEA else [],
        # ── KEGG BRITE category panels ───────────────────────────────────────
        expand("gsea/{contrast}/kegg/{slug}_dotplot.pdf",
               contrast=CONTRASTS, slug=KEGG_CATEGORIES) if KEGG_PANELS else [],
        # ── GO keyword category panels ───────────────────────────────────────
        expand("gsea/{contrast}/go/{slug}_dotplot.pdf",
               contrast=CONTRASTS, slug=GO_CATEGORIES) if GO_PANELS else [],
        # ── GSEA on the interaction contrasts ────────────────────────────────
        expand("gsea_interaction/{interaction}/{collection}_results.csv",
               interaction=INTERACTIONS,
               collection=GSEA_COLLECTIONS) if GSEA and DESEQ2 else [],
        # ── GO enrichment ─────────────────────────────────────────────────────
        expand("go/{contrast}/go_{ont}_{dir}_results.csv",
               contrast=CONTRASTS,
               ont=[o.lower() for o in GO_ONTOLOGIES],
               dir=["up", "down"]) if GOENRICH else [],
        # ── Contrast comparisons ──────────────────────────────────────────────
        expand("gsea_compare/{comparison}/delta_nes_summary.csv",
               comparison=CONTRAST_COMPARISONS) if GSEA and CONTRAST_COMPARISONS else [],
    default_target: True
    localrule: True
